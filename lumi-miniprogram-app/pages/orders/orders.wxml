<view class="page">
  <view class="page-pad" style="padding-bottom:60rpx">
    <view class="page-title">我的报名</view>
    <view class="page-sub">共 {{list.length}} 条记录</view>

    <block wx:if="{{list.length}}">
      <view class="order-card" wx:for="{{list}}" wx:key="id">
        <view class="order-top">
          <text class="oid">订单号 {{item.id}}</text>
          <text class="badge {{item.status === 'paid' ? 'grass' : 'sun'}}">{{item.status === 'paid' ? '已支付' : '待支付'}}</text>
        </view>
        <view class="order-body">
          <view class="cover" style="background:linear-gradient(150deg,{{item.c1}},{{item.c2}})">
            <view class="lv-tag">{{item.levelTag}}</view>
            <text class="emo">{{item.emoji}}</text>
          </view>
          <view style="flex:1;min-width:0">
            <view class="ob-title">{{item.title}}</view>
            <view class="ob-meta">{{item.dateText}} {{item.time}}</view>
            <view class="ob-meta">{{item.place}} · {{item.childName}}</view>
          </view>
        </view>
        <view class="order-foot">
          <view class="amt">¥{{item.amount}}</view>
          <view class="order-acts">
            <view wx:if="{{item.status === 'pending'}}" class="btn-sm primary" bindtap="resumePay" data-id="{{item.id}}">继续支付</view>
            <view wx:else class="btn-sm" bindtap="viewTicket" data-id="{{item.id}}">查看凭证</view>
            <view class="btn-sm" bindtap="goDetail" data-id="{{item.eventId}}">活动详情</view>
          </view>
        </view>
      </view>
    </block>

    <view class="empty" wx:else>
      <view class="e-ic">🎈</view>
      <view class="e-t">还没有报名记录</view>
    </view>
  </view>
</view>
